{
  "manifest_version": 3,
  "name": "LMS — загрузки через роутер",
  "short_name": "LMS",
  "version": "0.1.0",
  "description": "Находит на странице видео, файлы и magnet-ссылки, перехватывает загрузки и отправляет их в LMS на роутере.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LMS",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "contextMenus", "downloads", "notifications", "webRequest", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "send-page": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Отправить страницу в LMS (yt-dlp)"
    }
  }
}
